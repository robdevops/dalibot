# Copy to dalibot.env and fill in. Format: NAME=value (quote values containing spaces).
# Self-hosted: loaded by systemd (EnvironmentFile) or `set -a; . ./dalibot.env; set +a`.
# Serverless: set these as the function's environment variables instead.

# Mandatory
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Push (webhook) mode only. Leave unset to use Telegram long polling.
TELEGRAM_OUTGOING_TOKEN=
TELEGRAM_OUTGOING_WEBHOOK=

# Optional
#OPENAI_IMAGE_MODEL=dall-e-3
#TELEGRAM_BOT_COMMAND=dream
#TELEGRAM_ALLOWED_USER_IDS="123456789 987654321"
#DALIBOT_ARCHIVE=1
#DALIBOT_ARCHIVE_DIR=var/cache
#DALIBOT_DEBUG=1
#DALIBOT_IP=127.0.0.1
#DALIBOT_PORT=5000
