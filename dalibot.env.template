# Copy to dalibot.env and fill in. Format: NAME=value (quote values containing spaces).
# Self-hosted: loaded by systemd (EnvironmentFile) or `set -a; . ./dalibot.env; set +a`.
# Serverless: set these as the function's environment variables instead.

# Mandatory
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Push (webhook) mode only. Leave unset to use Telegram long polling.
TELEGRAM_OUTGOING_TOKEN=
TELEGRAM_OUTGOING_WEBHOOK=

# Optional
# Image history, so the buttons can switch between images: sqlite (self-hosted default) or dynamodb (Lambda default)
#DALIBOT_STORE=sqlite
#DALIBOT_DB=var/dalibot.db
#DALIBOT_TABLE=dalibot
#DALIBOT_STORE_DAYS=90
# Model for the default command; /gpt, /flux and /qwen select their own
#OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
# Cheap text model that removes conflicting words from the prompt when a style button is pressed
#OPENROUTER_TEXT_MODEL=meta-llama/llama-3.1-8b-instruct
#TELEGRAM_BOT_COMMAND=dream
#TELEGRAM_ALLOWED_USER_IDS="123456789 987654321"
#DALIBOT_ARCHIVE=1
#DALIBOT_ARCHIVE_DIR=var/cache
#DALIBOT_DEBUG=1
#DALIBOT_IP=127.0.0.1
#DALIBOT_PORT=5000
